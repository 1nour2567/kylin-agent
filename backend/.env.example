# Runtime mode
ENVIRONMENT=development
AGENT_MODE=mock

# Task-Level CapBAC. Use a dedicated random production secret. Never reuse
# API_KEY or an LLM provider key.
CAPABILITY_TOKEN_SECRET=
CAPABILITY_TOKEN_TTL_SECONDS=60
CAPABILITY_REPLAY_STORE=

# Tool-output indirect prompt injection defense
IPI_OUTPUT_MODE=block
IPI_MAX_SCAN_CHARS=20000
IPI_MAX_DECODE_DEPTH=2

